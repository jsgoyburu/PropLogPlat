# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno — copiar a .env y completar antes de ejecutar el proyecto
# ─────────────────────────────────────────────────────────────────────────────

# ── Seguridad ─────────────────────────────────────────────────────────────────
# Clave secreta de Django. Generar una nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambiar-por-una-clave-secreta-larga-y-aleatoria

# Protege el asistente web /accounts/instalar/ hasta crear el primer admin.
# Usá una frase larga y privada; después de instalar, el asistente queda cerrado.
SETUP_TOKEN=cambiar-por-una-clave-de-instalacion

# True en desarrollo local, False en producción.
DEBUG=True

# Hosts permitidos (separados por coma). En Railway se configura automáticamente.
# Ejemplo: ALLOWED_HOSTS=mi-dominio.railway.app,mi-dominio.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes completos autorizados para formularios en producción.
# CSRF_TRUSTED_ORIGINS=https://mi-dominio.com

# ── Base de datos ─────────────────────────────────────────────────────────────
# En desarrollo local se puede omitir (usa SQLite automáticamente).
# En Railway, PostgreSQL la inyecta automáticamente; no es necesario configurarla.
# DATABASE_URL=postgres://usuario:contraseña@host:5432/nombre_bd
# En desarrollo, agregar USE_DATABASE_URL=True para usarla en vez de SQLite.
# En producción (DEBUG=False) DATABASE_URL se usa automáticamente.

# Cache compartida opcional, recomendada con múltiples procesos/réplicas.
# REDIS_URL=redis://usuario:contraseña@host:6379/0

# Puerto interno. Los proveedores administrados suelen inyectarlo.
# PORT=8000

# ── Admin inicial ─────────────────────────────────────────────────────────────
# Credenciales del primer superusuario, creado automáticamente en el primer deploy.
# Si ya existe un superusuario, estas variables se ignoran.
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@ejemplo.com
# ADMIN_PASSWORD=elegir-una-contraseña-segura

# ── Email (recuperación de contraseña) ────────────────────────────────────────
# El backend se elige en cascada: BREVO_API_KEY → EMAIL_HOST → consola.
#
# ES IMPORTANTE cuál se use en Railway: Railway BLOQUEA los puertos SMTP
# salientes (25, 465, 587 y 2525) en los planes Free, Trial y Hobby, y solo los
# abre en Pro. En esos planes el backend SMTP no puede conectarse a ningún
# proveedor y falla con "Network is unreachable". El 443 no se bloquea nunca,
# así que en Railway va la API.

# --- Opción 1 (la de producción): API HTTP de Brevo ---
# Una sola variable. Se saca del panel de Brevo, en SMTP & API → API Keys.
# Funciona en cualquier plan de Railway.
# BREVO_API_KEY=xkeysib-...

# --- Opción 2: SMTP ---
# Sirve en local, en Railway Pro y en cualquier otro hosting. Con Brevo:
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=<el mail de login de la cuenta de Brevo>
# EMAIL_HOST_PASSWORD=<la SMTP key del panel, NO la contraseña de la cuenta>
# EMAIL_USE_TLS=True
#
# EMAIL_USE_SSL solo si el proveedor usa el puerto 465. Es mutuamente
# excluyente con EMAIL_USE_TLS: si ponés SSL en True, poné TLS en False, o
# Django levanta ImproperlyConfigured al arrancar.
# EMAIL_USE_SSL=False
#
# Alternativa de proveedor: smtp.mailgun.org:587, usuario
# postmaster@practicaslogica.com.ar. Se eligió Brevo por una razón operativa,
# no técnica: Mailgun exige tarjeta de crédito para mandar a destinatarios no
# autorizados, aunque nunca se llegue al límite.

# --- Opción 3 (default): sin ninguna de las dos ---
# Los mails se imprimen en la consola con el link clickeable. Alcanza para
# desarrollo. ATENCIÓN en producción: quien pida recuperar su contraseña ve la
# pantalla de "revisá tu correo" y no le llega nada nunca.

# Para probar la configuración, sin pasar por la pantalla de recuperación:
#   python manage.py sendtestemail vos@ejemplo.com

# Remitente que ve quien recibe el mail. Tiene que ser una dirección del
# dominio autenticado en el proveedor (SPF + DKIM): si no, DMARC falla y el
# mail se va a spam. En Brevo el dominio se autentica con un TXT de
# verificación, dos CNAME de DKIM (mail._domainkey y mail2._domainkey) y un TXT
# de DMARC en _dmarc.
#
# DEFAULT_FROM_EMAIL=IPC · Lógica <no-reply@practicaslogica.com.ar>
#
# OJO: esa casilla no existe como buzón. Lxs estudiantes igual le van a
# responder, y esas respuestas se pierden. Si eso importa, configurar un
# reenvío a nivel DNS hacia una casilla real. No montar un servidor de correo
# en Railway: el puerto 25 saliente está bloqueado, el filesystem es efímero y
# no se controla el DNS inverso de la IP.
#
# El dominio generado por Railway (*.up.railway.app) NO sirve de remitente:
# Railway es dueño de esa zona DNS y no se le pueden cargar SPF ni DKIM.

# ── Proxies de confianza ──────────────────────────────────────────────────────
# Cuántos proxies hay delante de la app. Se usa para leer X-Forwarded-For y
# calcular el techo de pedidos por IP en la recuperación de contraseña.
# En Railway es 1 (su edge), que es el default. Subirlo solo si se agrega otro
# proxy delante, por ejemplo un CDN: ponerlo de más hace que se confíe en un
# valor que escribió el cliente y el techo por IP deja de servir.
# TRUSTED_PROXY_COUNT=1

# ── Pistas pedagógicas con IA ─────────────────────────────────────────────────
# Ambas son opcionales. Gemini es el proveedor principal y Groq el fallback;
# Groq también puede revisar diccionarios de formalización.
# GEMINI_API_KEY=
# GROQ_API_KEY=

# ── Servidor MCP separado ─────────────────────────────────────────────────────
# Solo se usan al ejecutar mcp_intentos.py, no en el proceso web común.
# MCP_TRANSPORT=stdio
# Para transporte HTTP con OAuth:
# MCP_TRANSPORT=http
# MCP_ISSUER_URL=https://emisor-oauth.example.org/
